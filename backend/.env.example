# KALUSAGAP — backend environment variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed. Keep real credentials out
# of this example file.

# Port the API listens on.
PORT=5000

# Origin of the React development server, allowed through CORS.
# Development also allows http://localhost:5173 and http://127.0.0.1:5173.
# Production requires CLIENT_URL or CORS_ORIGIN. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# development | test | production
NODE_ENV=development

# Express proxy trust. Keep the local default for development; in production,
# set this to the specific proxy topology documented by the hosting provider.
# Do not set `true` unless every trusted proxy strips or safely overwrites
# client-supplied forwarding headers.
# TRUST_PROXY=loopback

# --- Supabase (server side) --------------------------------------------------
# Set these for Supabase-backed authentication and database routes. The API can
# start without them, but routes that require Supabase return a service error.
# The service-role key bypasses Row Level Security, so it belongs only on the
# server, never in the frontend or a VITE_ variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Personnel notification email (existing Nodemailer SMTP) -----------------
# All four SMTP values are required; absent configuration records a failed job.
SMTP_HOST=
# Port 465 uses implicit TLS; other ports require STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Durable outbox polling: default 60 seconds, bounded to 10..3600 seconds.
PERSONNEL_NOTIFICATION_INTERVAL_SECONDS=60
# Mail links require explicit CLIENT_URL above (first origin if comma-separated).
# Allow CLIENT_URL/reset-password in the Supabase Auth redirect URL allowlist.
# Supabase Auth email OTP expiry controls invitation/recovery link expiration;
# configure it in the Supabase dashboard, not as an application email TTL.

# --- Local data store (dev only) ---------------------------------------------
# Directory that holds the JSON store used while Supabase is not configured.
# Optional: defaults to ./data relative to the backend working directory.
# DATA_DIR=

# KALUSAGAP — backend environment variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed. Keep real credentials out
# of this example file.

# Port the API listens on.
PORT=5000

# Origin of the React development server, allowed through CORS.
# Comma-separate the list if more than one origin needs access.
CLIENT_URL=http://localhost:5173

# development | test | production
NODE_ENV=development

# --- Supabase (server side) --------------------------------------------------
# Fill these in when the Supabase project exists. The service-role key bypasses
# Row Level Security, so it belongs ONLY on the server — never in the frontend,
# never in a VITE_ variable, never in a commit. Leave blank locally: the server
# boots on the local file driver and development auth is enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local data store (dev only) ---------------------------------------------
# Directory that holds the JSON store used while Supabase is not configured.
# Optional: defaults to ./data relative to the backend working directory.
# DATA_DIR=

# --- Development auth --------------------------------------------------------
# Optional secret for signing local dev-session tokens. When omitted the server
# derives a persistent random secret under DATA_DIR. Ignored in production and
# whenever Supabase is configured.
# DEV_AUTH_SECRET=

# KALUSAGAP — backend environment variables
#
# Native development settings belong in `.env`. Configure the existing hosted
# Supabase project or a dedicated hosted development project below.
#
# `.env` is git-ignored and must never be committed. Keep real credentials out
# of this example file.

# Port the API listens on.
PORT=5000

# Canonical frontend origin used by every backend-generated authentication email.
# Keep this to one origin. Development uses http://localhost:5173; production
# requires an HTTPS public origin such as https://kalusagap.vercel.app.
CLIENT_URL=http://localhost:5173

# Optional additional browser origins allowed through CORS (for staging/previews).
# This list never supplies authentication email redirect destinations.
# CORS_ORIGIN=https://preview.example.com,https://staging.example.com

# development | test | production
NODE_ENV=development

# Default is local Supabase. For a dedicated NON-PRODUCTION hosted project,
# set SUPABASE_MODE=hosted-development and use its HTTPS URL and matching keys.
# The backend then restricts Supabase requests to that exact project origin.
# SUPABASE_MODE=hosted-development

# Express proxy trust. Keep the local default for development; in production,
# set this to the specific proxy topology documented by the hosting provider.
# Do not set `true` unless every trusted proxy strips or safely overwrites
# client-supplied forwarding headers.
# TRUST_PROXY=loopback

# --- Supabase (server side) --------------------------------------------------
# Use keys from local `supabase status` or a dedicated non-production hosted
# project when `SUPABASE_MODE=hosted-development`. The server never substitutes
# the JSON file store.
# The service-role key bypasses Row Level Security, so it belongs only on the
# server, never in the frontend or a VITE_ variable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Personnel notification email (existing Nodemailer SMTP) -----------------
# Local development uses Supabase's email capture, without SMTP auth/TLS.
# Hosted development may use a remote SMTP provider only with credentials and
# mandatory TLS. Production also requires authenticated TLS SMTP from hosting.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kalusagap.test
OTP_PEPPER=

# Durable outbox polling: default 60 seconds, bounded to 10..3600 seconds.
PERSONNEL_NOTIFICATION_INTERVAL_SECONDS=60
# Mail links require the explicit canonical CLIENT_URL above.
# Allow CLIENT_URL/reset-password in the Supabase Auth redirect URL allowlist.
# Supabase Auth email OTP expiry controls invitation/recovery link expiration;
# configure it in the Supabase dashboard, not as an application email TTL.
# In development, the personnel notification worker only claims jobs from a
# loopback/local Supabase URL. Hosted-Supabase development disables that worker.

# External AI API keys must be absent in development.

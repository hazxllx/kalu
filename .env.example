# KALUSAGAP — environment variables
#
# Copy this file to `.env.local` for local development, and set the same keys in
# the Vercel project settings (Settings -> Environment Variables) for production.
#
# Only VITE_-prefixed variables are exposed to the browser by Vite. Never put
# private keys, database credentials, or service-role tokens in this file.

# Identifier of the backend app this frontend talks to.
VITE_APP_ID=

# Base URL of the deployed backend. Leave blank to use same-origin /api requests.
# Example: https://your-app.example.app
VITE_APP_BASE_URL=

# Optional backend functions version pin. Leave blank to use the default.
VITE_FUNCTIONS_VERSION=

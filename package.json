{
  "name": "kalusagap",
  "version": "0.1.0",
  "private": true,
  "description": "KALUSAGAP — Community Health Risk Monitoring and Early Intervention System",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "local:configure": "node scripts/configure-local.mjs",
    "local:status": "node scripts/configure-local.mjs --status",
    "local:db:migrate": "supabase migration up --local",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "lint": "npm run lint --prefix frontend"
  }
}

# KALUSAGAP — frontend environment variables
#
# Copy this file to `.env` (or `.env.local`) for local development and set the
# same keys in your hosting provider's project settings for production.
#
# Only VITE_-prefixed variables are exposed to the browser by Vite.
# NEVER put private keys, database credentials, or service-role tokens here —
# anything in this file ends up in the shipped JavaScript bundle.

# Base URL of the KALUSAGAP backend API (backend/ in this repository).
# Example for local development: http://localhost:5000/api
VITE_API_URL=

# --- Supabase (browser) ------------------------------------------------------
# Only the public anon key belongs here. NEVER put the service-role key or any
# private secret in a VITE_ variable — everything here ships in the JS bundle.
# Access is ultimately controlled by Supabase Row Level Security.
# Leave blank to run the UI on the local dev-auth fallback (test accounts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Legacy platform parameters (read by src/lib/app-params.js) -------------
# Identifier of the backend app this frontend talks to.
VITE_APP_ID=

# Base URL of the deployed platform backend. Leave blank to use same-origin
# /api requests. Example: https://your-app.example.app
VITE_APP_BASE_URL=

# Optional backend functions version pin. Leave blank to use the default.
VITE_FUNCTIONS_VERSION=

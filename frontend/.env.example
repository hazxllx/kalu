# Local development only: use npm run local:configure to generate .env.development.
# Vite loads only .env.<mode> and .env.<mode>.local for non-production modes.
# Legacy .env/.env.local and shell VITE_ variables are not used locally.
# Values are literal; shell/variable interpolation is intentionally disabled.
# Use npm run dev locally; preview is blocked because dist may contain a stale
# production bundle. No hosted bundle is served by the local development server.
VITE_APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
# Keep blank until local Supabase supplies its anon JWT (role=anon,
# issuer=supabase-demo, no hosted project ref). Never paste hosted keys here.
# The client requires these public browser variables; no auth fallback is used.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Intentional public maps: OpenFreeMap styles/tiles/sprites/glyphs are allowed by
# the local CSP ONLY at https://tiles.openfreemap.org. Map requests expose network
# metadata / viewed map area to that provider; application data stays local.
# May instead point to a loopback-hosted compatible style; its exact origin is
# added to the local CSP. Nested resources must use these same allowed origins.
# Public attribution and information links remain unchanged.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

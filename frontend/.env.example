# KALUSAGAP frontend environment variables
#
# Copy this file to `.env` (or `.env.local`) for local development:
#   Copy-Item .env.example .env
#
# Only VITE_-prefixed variables are exposed to the browser. Never put private
# keys, database credentials, or service-role tokens in this file.

# Local backend API. The Express server listens on port 5000 by default.
VITE_API_URL=http://localhost:5000/api

# Public Supabase browser configuration. Keep these aligned with backend/.env
# when Supabase-backed authentication is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional legacy platform parameters. Leave blank for the local app.
VITE_APP_ID=
VITE_APP_BASE_URL=
VITE_FUNCTIONS_VERSION=
